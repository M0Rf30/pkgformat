<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE comps PUBLIC "-//Red Hat, Inc.//DTD Comps info//EN" "comps.dtd">
<comps>
  <group arch="x86_64,aarch64">
    <id>multilib-tools</id>
    <name>Multilib Tools</name>
    <name xml:lang="de">Multilib-Werkzeuge</name>
    <name xml:lang="fr">Outils multi-architecture</name>
    <description>Tools for a system that runs two ABIs &amp; more</description>
    <description xml:lang="de">Werkzeuge für ein System mit zwei ABIs</description>
    <description xml:lang="fr">Outils d'un système à deux ABI</description>
    <default>true</default>
    <uservisible>false</uservisible>
    <biarchonly>true</biarchonly>
    <display_order>7</display_order>
    <langonly>de</langonly>
    <packagelist>
      <packagereq arch="x86_64" basearchonly="true" type="mandatory">glibc-devel</packagereq>
      <packagereq requires="glibc-devel" type="conditional">glibc-static</packagereq>
      <packagereq arch="aarch64,x86_64" type="optional">strace</packagereq>
      <packagereq type="default">make</packagereq>
    </packagelist>
  </group>
  <group>
    <id>empty-group</id>
    <name>Empty Group</name>
    <description>A group without packages</description>
    <default>false</default>
    <uservisible>true</uservisible>
  </group>
  <category arch="x86_64">
    <id>tools</id>
    <name>Tools</name>
    <name xml:lang="de">Werkzeuge</name>
    <description>The "tools" category</description>
    <display_order>3</display_order>
    <grouplist>
      <groupid>multilib-tools</groupid>
      <groupid arch="aarch64,x86_64">empty-group</groupid>
    </grouplist>
  </category>
  <environment arch="aarch64">
    <id>tools-environment</id>
    <name>Tools Environment</name>
    <name xml:lang="de">Werkzeugumgebung</name>
    <description>An environment of tools</description>
    <description xml:lang="de">Eine Umgebung von Werkzeugen</description>
    <display_order>1</display_order>
    <grouplist>
      <groupid>multilib-tools</groupid>
    </grouplist>
    <optionlist>
      <groupid default="true">empty-group</groupid>
      <groupid arch="x86_64">multilib-tools</groupid>
    </optionlist>
  </environment>
  <langpacks>
    <match install="aspell-%s" name="aspell"/>
    <match install="hunspell-%s" name="hunspell"/>
  </langpacks>
  <blacklist>
    <package name="dev"/>
    <package arch="i386" name="dbus"/>
  </blacklist>
  <whiteout>
    <ignoredep package="bind" requires="bind-utils"/>
    <ignoredep requires="db1"/>
  </whiteout>
</comps>
